@@ -0,0 +1,27 @@
+// Neural Amplifier decision hooks (eval/research adapter; patch carried by scbrown/NeuralAmplifier,
+// adapters/opensmac). Inert unless NA_OPENSMAC_MODE is "live" or "replay".
+//
+// Each hook receives the engine's own (default) choice and returns the choice to apply. Live mode
+// asks the decider (the in-process stub unless one is installed), checks legality, appends one
+// JSONL decision record and applies it. Replay mode reads the record for the same
+// (turn, faction, surface, key, seq), recomputes inputs_sha256, exits loudly on a divergence,
+// applies the logged choice through the same legality check and never calls the decider.
+#pragma once
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace na {
+
+// A decider maps the canonical inputs (JSON bytes) and the legal options to a choice.
+// `fallback` is the engine's own choice; returning it is always legal.
+using Decider = int32_t (*)(const char* surface, const std::string& inputs_json,
+                            const std::vector<int32_t>& legal, int32_t fallback);
+void set_decider(Decider d);
+
+int32_t hook_base_build(int32_t base_id, int32_t choice);
+int32_t hook_tech_selection(int32_t faction_id, int32_t choice);
+int32_t hook_social_ai(int32_t faction_id, int32_t packed_choice);
+int32_t hook_base_hurry(int32_t faction_id, int32_t base_id, int32_t spend, int32_t credits, int32_t need);
+
+}  // namespace na
