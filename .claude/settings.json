{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "command -v yupana >/dev/null 2>&1 && yupana hook pre-edit || true",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ]
  }
}
