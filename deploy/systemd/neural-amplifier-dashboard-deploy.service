[Unit]
Description=Deploy new NeuralAmplifier dashboard main revision
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/workspace/NeuralAmplifier
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/workspace/NeuralAmplifier/scripts/deploy-dashboard.sh
NoNewPrivileges=true
PrivateTmp=true
