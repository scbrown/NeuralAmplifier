# The na:Skill vocabulary and its SHACL shape: the skill library of
# docs/seats-and-policy.md §5.4-5.5, one seat book per Quipu store.
#
# This file lives in this repository (ruled option (b)): it is loaded into a
# seat's own store by orchestrator/src/neural_amplifier/skill_shapes.py, which
# pins these exact bytes by sha256. Editing this file means updating that pin.
#
# It matches orchestrator/src/neural_amplifier/skills.py: what skills.py
# accepts, this shape accepts, and what skills.py refuses, this shape refuses.
# One na:Skill node per VERSION, at <skill/NAME/vVERSION>; the content hash is a
# property, not the identity. A rewrite is a new node that na:supersedes the
# old one, so the library as it stood at any earlier moment stays readable.
# skill_shapes.to_turtle() is the serialisation this shape is tested against.
#
# The Quipu-backed store (skill_quipu.py) is APPEND-ONLY: nothing is retracted
# on a normal write. A na:Skill node is written once; its na:status is the
# status it was written with. A status change, a trial or a retirement is a new
# immutable na:SkillState record, and readers take the latest state (highest
# na:tx) per version. In the commons, a state counts only when a committed
# na:Publication lists it in na:carriesState; the states and the publication
# are one knot, so a refused or crashed write leaves the old state readable.

@prefix na:   <http://neuralamplifier.local/ontology/skill/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# --- vocabulary -------------------------------------------------------------

na:Skill a owl:Class ;
    rdfs:label "Skill" ;
    rdfs:comment "One immutable version of a deterministic Starlark script that answers decisions." .

na:Trial a owl:Class ;
    rdfs:comment "One run of a skill version from a game or a fixture, with its verdict and metric deltas." .

na:SuccessCheck a owl:Class ;
    rdfs:comment "What success means for a skill, in the metric vocabulary: metric, comparator, target, horizon." .

na:name            a owl:DatatypeProperty ; rdfs:domain na:Skill .
na:version         a owl:DatatypeProperty ; rdfs:domain na:Skill .
na:description     a owl:DatatypeProperty ; rdfs:domain na:Skill ;
    rdfs:comment "What retrieval matches. The description, not the code, is embedded." .
na:code            a owl:DatatypeProperty ; rdfs:domain na:Skill .
na:contentHash     a owl:DatatypeProperty ; rdfs:domain na:Skill ;
    rdfs:comment "sha256 of na:code, hex. What a decision record cites." .
na:params          a owl:DatatypeProperty ; rdfs:domain na:Skill ;
    rdfs:comment "Default parameters passed to every entry point, as one JSON object (sorted keys)." .
na:status          a owl:DatatypeProperty ; rdfs:domain na:Skill ;
    rdfs:comment "candidate, verified or retired. Only verified skills answer in a live game." .
na:retiredReason   a owl:DatatypeProperty ; rdfs:domain na:Skill ;
    rdfs:comment "Why a version was retired, when it was." .
na:supersedes      a owl:ObjectProperty ; rdfs:domain na:Skill ;
    rdfs:comment "The version this one replaces, named by its content hash." .
na:calls           a owl:ObjectProperty ; rdfs:domain na:Skill ; rdfs:range na:Skill .
na:requiresSurface a owl:DatatypeProperty ; rdfs:domain na:Skill ;
    rdfs:comment "A surface id (surfaces.py) the skill applies to. None means any." .
na:requiresKnob    a owl:DatatypeProperty ; rdfs:domain na:Skill ;
    rdfs:comment "A knob id (faction_policy.py) the skill touches, such as focus.fight." .
na:engine          a owl:DatatypeProperty ; rdfs:domain na:Skill .
na:successCheck    a owl:ObjectProperty ; rdfs:domain na:Skill ; rdfs:range na:SuccessCheck .
na:trial           a owl:ObjectProperty ; rdfs:domain na:Skill ; rdfs:range na:Trial .
na:authoredBy      a owl:DatatypeProperty ; rdfs:domain na:Skill ;
    rdfs:comment "Seat identity that wrote this version." .
na:authoredInGame  a owl:DatatypeProperty ; rdfs:domain na:Skill .
na:authoredAtTurn  a owl:DatatypeProperty ; rdfs:domain na:Skill .
na:authoredWithModel a owl:DatatypeProperty ; rdfs:domain na:Skill .

na:SkillState a owl:Class ;
    rdfs:comment "One immutable state of one skill version: status, trials so far, retired reason. The latest by na:tx wins." .

na:Publication a owl:Class ;
    rdfs:comment "One seat's sharing step at the end of one game: the exact commons states it carries." .

na:ofVersion   a owl:ObjectProperty ; rdfs:domain na:SkillState ; rdfs:range na:Skill .
na:tx          a owl:DatatypeProperty ;
    rdfs:comment "Write ordinal within its store: one more than the largest na:tx already there. Orders states and publications." .
na:publishedBy a owl:DatatypeProperty ; rdfs:domain na:Publication ;
    rdfs:comment "Seat identity that published." .
na:game        a owl:DatatypeProperty ; rdfs:domain na:Publication ;
    rdfs:comment "The game whose end this publication records." .
na:carriesState a owl:ObjectProperty ; rdfs:domain na:Publication ; rdfs:range na:SkillState ;
    rdfs:comment "A commons state this publication commits. States no publication carries are ignored." .

na:metric     a owl:DatatypeProperty ;
    rdfs:comment "A metric name: of a success check, or of one trial delta." .
na:comparator a owl:DatatypeProperty ; rdfs:domain na:SuccessCheck .
na:target     a owl:DatatypeProperty ; rdfs:domain na:SuccessCheck .
na:horizonTurns a owl:DatatypeProperty ; rdfs:domain na:SuccessCheck .

na:source   a owl:DatatypeProperty ; rdfs:domain na:Trial ;
    rdfs:comment "The game id or fixture name the trial ran from." .
na:seed     a owl:DatatypeProperty ; rdfs:domain na:Trial .
na:verdict  a owl:DatatypeProperty ; rdfs:domain na:Trial .
na:delta    a owl:ObjectProperty ; rdfs:domain na:Trial ;
    rdfs:comment "One metric's change over the trial: a node with na:metric and na:value." .
na:value    a owl:DatatypeProperty ;
    rdfs:comment "The change in na:metric over a trial." .

# --- shapes -----------------------------------------------------------------

na:SkillShape a sh:NodeShape ;
    sh:targetClass na:Skill ;
    sh:property [
        sh:path na:name ; sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[a-z][a-z0-9_]{0,63}$" ;
    ] , [
        sh:path na:version ; sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ;
    ] , [
        sh:path na:description ; sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ;
    ] , [
        sh:path na:code ; sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] , [
        sh:path na:contentHash ; sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9a-f]{64}$" ;
    ] , [
        sh:path na:params ; sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^\\{.*\\}$" ;
    ] , [
        sh:path na:status ; sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "candidate" "verified" "retired" ) ;
    ] , [
        sh:path na:retiredReason ; sh:datatype xsd:string ;
        sh:maxCount 1 ; sh:minLength 1 ;
    ] , [
        sh:path na:supersedes ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
    ] , [
        sh:path na:calls ; sh:class na:Skill ;
    ] , [
        sh:path na:requiresSurface ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] , [
        sh:path na:requiresKnob ; sh:datatype xsd:string ;
        sh:pattern "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" ;
    ] , [
        sh:path na:engine ; sh:datatype xsd:string ; sh:in ( "thinker" "glsmac" ) ;
    ] , [
        sh:path na:successCheck ; sh:class na:SuccessCheck ;
        sh:maxCount 1 ;
    ] , [
        sh:path na:trial ; sh:class na:Trial ;
    ] , [
        sh:path na:authoredBy ; sh:datatype xsd:string ; sh:maxCount 1 ;
    ] .

# na:status, na:retiredReason and na:trial on a state mean what they mean on
# na:Skill: the state replaces the version's own values from its na:tx on.
# A state names a version (and trials) written in EARLIER transactions, and qp
# runs this shape over the submitted document only, so these references are
# sh:nodeKind sh:IRI, not sh:class; readers check the target's type.
na:SkillStateShape a sh:NodeShape ;
    sh:targetClass na:SkillState ;
    sh:property [
        sh:path na:ofVersion ; sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] , [
        sh:path na:status ; sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "candidate" "verified" "retired" ) ;
    ] , [
        sh:path na:retiredReason ; sh:datatype xsd:string ;
        sh:maxCount 1 ; sh:minLength 1 ;
    ] , [
        sh:path na:trial ; sh:nodeKind sh:IRI ;
    ] , [
        sh:path na:tx ; sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ;
    ] .

na:PublicationShape a sh:NodeShape ;
    sh:targetClass na:Publication ;
    sh:property [
        sh:path na:publishedBy ; sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ;
    ] , [
        sh:path na:game ; sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ;
    ] , [
        sh:path na:tx ; sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ;
    ] , [
        sh:path na:carriesState ; sh:nodeKind sh:IRI ;
    ] .

# metric: exactly metrics.VOCABULARY, sorted. A test keeps the two equal.
na:SuccessCheckShape a sh:NodeShape ;
    sh:targetClass na:SuccessCheck ;
    sh:property [
        sh:path na:metric ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "base_count" "drone_total" "energy_income" "energy_reserves"
                "factions_at_war" "labs_output" "military_units" "mineral_surplus"
                "minerals_remaining" "pop_size" "pop_total" "turns_to_completion"
                "units_in_foreign_territory" ) ;
    ] , [
        sh:path na:comparator ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "at_least" "at_most" ) ;
    ] , [
        # xsd:decimal has no NaN or infinity, so a conforming target is finite.
        sh:path na:target ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ;
    ] , [
        sh:path na:horizonTurns ; sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ;
    ] .

na:TrialShape a sh:NodeShape ;
    sh:targetClass na:Trial ;
    sh:property [
        sh:path na:source ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 1 ;
    ] , [
        sh:path na:seed ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
    ] , [
        sh:path na:verdict ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "pass" "fail" ) ;
    ] , [
        sh:path na:delta ; sh:node na:DeltaShape ;
    ] .

na:DeltaShape a sh:NodeShape ;
    sh:property [
        sh:path na:metric ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
    ] , [
        sh:path na:value ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ;
    ] .
